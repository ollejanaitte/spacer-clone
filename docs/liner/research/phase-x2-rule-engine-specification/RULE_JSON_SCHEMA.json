{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LINER Rule Engine Rule",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^X2-R-\\d{3}$"
    },
    "rule_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "rule_category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "applicability": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "road_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "lookup_table": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "min_value": {
          "type": "number"
        },
        "max_value": {
          "type": "number"
        },
        "recommended_value": {
          "type": "number"
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "FATAL",
            "NOT_APPLICABLE"
          ]
        },
        "error_code": {
          "type": "string"
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_order": {
          "type": "integer"
        }
      }
    },
    "implementation": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "x3_readiness": {
          "type": "string",
          "enum": [
            "READY_FOR_IMPLEMENTATION",
            "NEEDS_RESEARCH",
            "BLOCKED"
          ]
        }
      }
    }
  },
  "required": [
    "rule_id",
    "rule_category",
    "title",
    "inputs",
    "constraints",
    "outputs",
    "validation"
  ]
}