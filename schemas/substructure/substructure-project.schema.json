{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substructure-planning-lab.local/schemas/substructure-project.schema.json",
  "title": "SubstructureProject",
  "description": "下部工計画・3Dモデリングツールのプロジェクト全体。上部工とは交換スキーマ(support-interface)で疎結合連携する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "source",
    "coordinateSystem",
    "unitSystem",
    "origin",
    "alignmentRefs",
    "supports",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0",
      "description": "このスキーマのバージョン。不一致の場合は fail-closed で拒否する。"
    },
    "projectId": { "type": "string", "minLength": 1 },
    "bridgeId": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "coord": {
      "type": "object",
      "required": ["system", "version"],
      "properties": {
        "system": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "coordinateSystem": {
      "const": "x-longitudinal-y-transverse-z-up",
      "description": "右手系 Z-up。+X=橋軸, +Y=橋軸直角(+Xを見て左が+), +Z=上。"
    },
    "unitSystem": {
      "const": "si",
      "description": "単位系。長さm, 角度deg, 力kN。"
    },
    "origin": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "alignmentRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alignmentId", "originStation"],
        "additionalProperties": false,
        "properties": {
          "alignmentId": { "type": "string" },
          "originStation": { "type": "number", "minimum": 0 },
          "totalLength": { "type": "number", "minimum": 0 }
        }
      }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/support" }
    },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportId",
        "supportType",
        "position"
      ],
      "properties": {
        "supportId": { "type": "string", "minLength": 1 },
        "supportType": {
          "type": "string",
          "enum": ["pier", "abutment"]
        },
        "longitudinalAxis": { "$ref": "#/$defs/vec3" },
        "transverseAxis": { "$ref": "#/$defs/vec3" },
        "verticalAxis": { "$ref": "#/$defs/vec3" },
        "skewAngle": {
          "type": "number",
          "description": "斜角。+Z軸回り CCW 正。deg。"
        },
        "position": { "$ref": "#/$defs/vec3" },
        "bearingSeats": {
          "type": "array",
          "items": { "$ref": "#/$defs/bearingSeat" }
        },
        "pier": { "$ref": "pier.schema.json#/$defs/pier" },
        "abutment": { "$ref": "abutment.schema.json#/$defs/abutment" }
      },
      "allOf": [
        {
          "if": { "properties": { "supportType": { "const": "pier" } } },
          "then": { "required": ["pier"] }
        },
        {
          "if": { "properties": { "supportType": { "const": "abutment" } } },
          "then": { "required": ["abutment"] }
        }
      ]
    },
    "bearingSeat": {
      "type": "object",
      "required": ["seatId", "position", "dimensions"],
      "additionalProperties": false,
      "properties": {
        "seatId": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "dimensions": {
          "type": "object",
          "required": ["w", "d", "h"],
          "additionalProperties": false,
          "properties": {
            "w": { "type": "number", "exclusiveMinimum": 0 },
            "d": { "type": "number", "exclusiveMinimum": 0 },
            "h": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "bearing": {
          "type": "object",
          "required": ["id", "height", "type"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "type": { "enum": ["elastomeric", "pot", "fixed", "custom"] }
          }
        }
      }
    },
    "vec3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["sourceApplication"],
      "additionalProperties": true,
      "properties": {
        "sourceApplication": { "type": "string" },
        "sourceVersion": { "type": "string" },
        "sourceRevision": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}