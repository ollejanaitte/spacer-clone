{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacer.local/schemas/contracts/v0.1/analysis-document.schema.json",
  "title": "AnalysisDocument",
  "description": "The analysis canonical document (Phase 7-01 A FROZEN). Schema v1.0.0.",
  "type": "object",
  "required": [
    "schemaId",
    "schemaVersion",
    "documentKind",
    "documentId",
    "projectId",
    "revisionId",
    "status",
    "contentChecksum",
    "modelChecksum",
    "provenance",
    "timestamps",
    "sourceReferences",
    "coordinateContext",
    "unitContext",
    "nodes",
    "members",
    "materials",
    "sections",
    "supports",
    "releases",
    "rigidLinks",
    "mpc",
    "bearings",
    "springs",
    "foundationSprings",
    "loadCases",
    "nodalLoads",
    "memberLoads",
    "loadCombinations",
    "analysisSettings",
    "analysisStatus",
    "resultReferences",
    "validation",
    "revision"
  ],
  "properties": {
    "schemaId": { "type": "string", "const": "spacer.contracts.analysis-document" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "documentKind": { "type": "string", "const": "analysis-document" },
    "documentId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "APPROVED", "STALE", "ARCHIVED"]
    },
    "contentChecksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "modelChecksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenance": { "type": "object" },
    "timestamps": { "type": "object" },
    "sourceReferences": {
      "type": "object",
      "properties": {
        "bridgeLayout": { "type": ["object", "null"] },
        "superstructure": { "type": ["object", "null"] },
        "substructure": { "type": ["object", "null"] },
        "loadFingerprint": { "type": ["string", "null"] },
        "solverSettingsFingerprint": { "type": ["string", "null"] }
      }
    },
    "coordinateContext": { "type": "object" },
    "unitContext": { "type": "object" },
    "nodes": { "type": "array", "items": { "type": "object" } },
    "members": { "type": "array", "items": { "type": "object" } },
    "materials": { "type": "array", "items": { "type": "object" } },
    "sections": { "type": "array", "items": { "type": "object" } },
    "supports": { "type": "array", "items": { "type": "object" } },
    "releases": { "type": "array", "items": { "type": "object" } },
    "rigidLinks": { "type": "array", "items": { "type": "object" } },
    "mpc": { "type": "array", "items": { "type": "object" } },
    "bearings": { "type": "array", "items": { "type": "object" } },
    "springs": { "type": "array", "items": { "type": "object" } },
    "foundationSprings": { "type": "array", "items": { "type": "object" } },
    "loadCases": { "type": "array", "items": { "type": "object" } },
    "nodalLoads": { "type": "array", "items": { "type": "object" } },
    "memberLoads": { "type": "array", "items": { "type": "object" } },
    "loadCombinations": { "type": "array", "items": { "type": "object" } },
    "analysisSettings": { "type": "object" },
    "analysisStatus": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "STALE",
        "PARTIAL",
        "NOT_AVAILABLE",
        "NOT_AUTHORIZED"
      ]
    },
    "resultReferences": { "type": "array", "items": { "type": "object" } },
    "resultDigest": { "type": ["string", "null"] },
    "validation": { "type": "object" },
    "revision": { "type": "object" },
    "extensions": { "type": "object" }
  }
}
