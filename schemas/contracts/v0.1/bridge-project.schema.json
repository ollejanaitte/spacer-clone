                          {
                            "type": "string"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "CONFIRMED",
                      "DERIVED",
                      "INFERRED",
                      "MISSING",
                      "DEFERRED",
                      "NOT_AUTHORIZED"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "ORIGINAL",
