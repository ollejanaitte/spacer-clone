                "description": "Shared value carrying value/unit/source/status/generatedBy/updatedAt/sourceReference so that downstream tools never mistake a reconstructed value for a confirmed one."
              },
              "elevationM": {
                "type": "object",
                "properties": {
                  "value": {
                    "anyOf": [
                      {
