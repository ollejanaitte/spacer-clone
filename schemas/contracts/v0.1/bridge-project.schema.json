              "type": "string",
              "minLength": 1
            },
            "actorType": {
              "type": "string",
              "enum": [
                "user",
                "system",
                "tool"
              ]
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "actorId",
            "actorType"
          ],
          "additionalProperties": false
        },
        "producer": {
          "type": "object",
          "properties": {
            "toolId": {
              "type": "string",
              "minLength": 1
            },
            "toolVersion": {
              "type": "string",
