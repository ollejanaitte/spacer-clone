                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "supportId"
            ],
            "additionalProperties": false,
            "description": "Cross-tool support system fact (superstructure geometry + substructure placement consume the same support line). Canonical unit: m / rad."
          }
        },
        "reactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "supportId": {
                "type": "string",
                "minLength": 1
              },
              "caseKind": {
                "type": "string",
                "enum": [
                  "permanent",
                  "liveLoad",
                  "braking",
                  "wind",
                  "seismicLevel1",
                  "seismicLevel2"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "CONFIRMED",
                  "DERIVED",
                  "INFERRED",
                  "MISSING",
                  "DEFERRED",
                  "NOT_AUTHORIZED"
                ]
              },
              "force": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "moment": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              },
              "sourceReference": {
                "type": "string",
                "minLength": 1
              },
              "stateReason": {
                "type": "string"
              }
            },
            "required": [
              "supportId",
              "caseKind",
              "status"
            ],
            "additionalProperties": false,
            "description": "Reaction handoff fact. Canonical unit kN / kN·m. Status NOT_AUTHORIZED until an authorized analysis result exists; substructure tools must fail closed on it."
          }
        },
        "coordinateSystem": {
          "type": "string",
          "enum": [
            "x-longitudinal-y-transverse-z-up",
            "x-east-y-north-z-up"
          ]
        },
        "unitSystem": {
          "type": "string",
          "enum": [
            "si-m-rad-kn",
            "si"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Shared cross-tool handoff facts that today live in divergent structures (support interface, substructure Support, superstructure support lines)."
    },
    "reconstruction": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldKey": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "CONFIRMED",
                  "DERIVED",
                  "INFERRED",
                  "MISSING",
                  "DEFERRED",
                  "NOT_AUTHORIZED"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "derivationRef": {
                "type": "string",
                "minLength": 1
              },
              "stateReason": {
                "type": "string"
              }
            },
            "required": [
              "fieldKey",
              "status"
            ],
            "additionalProperties": false,
            "description": "One reconstructed/restored field with an explicit status so that a restored alignment is never presented as if it were the original confirmed input."
          }
        }
      },
      "additionalProperties": false,
      "description": "CASE B (superstructure sample -> alignment restore) provenance records. DERIVED/INFERRED entries must stay distinct from CONFIRMED originals."
    }
  },
  "required": [
    "schemaId",
    "schemaVersion",
    "documentId",
    "documentKind",
    "revisionId",
    "contentChecksum",
    "provenance",
    "projectId",
    "name",
    "projectRevisionMetadata",
    "status",
    "references"
  ],
