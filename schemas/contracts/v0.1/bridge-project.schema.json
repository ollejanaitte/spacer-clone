{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "spacer.contracts.bridge-project"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "documentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "documentKind": {
      "type": "string",
      "const": "bridge-project"
    },
    "revisionId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "contentChecksum": {
      "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/content-checksum.schema.json"
    },
    "provenance": {
      "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/provenance.schema.json"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+\\/[a-zA-Z][a-zA-Z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "json": {
            "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/json-value.schema.json"
          },
          "resourceRef": {
            "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/immutable-resource-reference.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "unknownFieldStoreRef": {
      "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
    },
    "migrationProvenanceRef": {
      "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "projectRevisionMetadata": {
      "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/revision-metadata.schema.json"
    },
    "status": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "road-alignment",
            "superstructure",
            "substructure",
            "reconciliation",
            "closed"
          ]
        },
        "sections": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "project",
              "alignment",
              "bridgeGeometry",
              "superstructure",
              "substructure",
              "analysis",
              "model3D",
              "metadata"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "enum": [
                  "ALIGNMENT_OWNER",
                  "SUPERSTRUCTURE_OWNER",
                  "SUBSTRUCTURE_OWNER",
                  "BRIDGE_PROJECT_SHARED"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "EMPTY",
                  "PARTIAL",
                  "COMPLETE",
                  "NOT_AUTHORIZED",
                  "DEFERRED"
                ]
              },
              "stateReason": {
                "type": "string"
              },
              "sourceDocumentRef": {
                "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
              }
            },
            "required": [
              "owner",
              "state"
            ],
            "additionalProperties": false,
            "description": "Ownership and completion state of one BridgeProject section."
          },
          "required": [
            "project",
            "alignment",
            "bridgeGeometry",
            "superstructure",
            "substructure",
            "analysis",
            "model3D",
            "metadata"
          ]
        }
      },
      "required": [
        "phase",
        "sections"
      ],
      "additionalProperties": false,
      "description": "Overall workflow phase and per-section ownership/status."
    },
    "references": {
      "type": "object",
      "properties": {
        "roadDesign": {
          "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
        },
        "commonModel": {
          "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
        },
        "superstructure": {
          "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
        },
        "analysis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
          }
        },
        "substructure": {
          "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
        },
        "model3D": {
          "$ref": "#/$defs/https://spacer.local/schemas/contracts/v0.1/document-reference.schema.json"
        }
      },
      "additionalProperties": false,
      "description": "References to the authoritative per-domain documents. Shared engineering facts are canonical in commonModel (CBDM); superstructure facts in superstructure (BSDD); substructure facts in substructure; analysis results in analysis (BFAD / result resources). BridgeProject coordinates, it does not duplicate them."
    },
