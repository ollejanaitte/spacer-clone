#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_NAME="$(uname -s)"

case "$OS_NAME" in
  Linux)
    exec "$ROOT_DIR/start-ubuntu.sh" "$@"
    ;;
  Darwin)
    if [[ $# -eq 0 ]]; then
      exec "$ROOT_DIR/start-mac.sh" --apollo
    fi
    exec "$ROOT_DIR/start-mac.sh" "$@"
    ;;
  *)
    echo "[エラー] この ./start wrapper は $OS_NAME をサポートしていません。" >&2
    echo "  Windows は start-windows.ps1 を使用してください。" >&2
    exit 1
    ;;
esac
